do_landing() {
  local host port proto uuid="" pbk="" sid="" enc="" ipver="" cipher="" pass="" sni=""
  hr
  printf ' 落地机 = 真正出网的那台（例如日本/新加坡 VPS）\n'
  printf ' 如果落地机也用本脚本部署，直接在那边「查看链接」抄参数即可。\n'
  hr
  ask host '落地机 IP 或域名' "$(st_get LANDING_HOST)"
  [ -z "$host" ] && return 1
  ask_port port '落地机端口' "$(st_get LANDING_PORT 35688)"

  printf ' 协议：1) Shadowsocks(2022)  2) VLESS Reality  3) Trojan  4) VLESS Encryption(PQ)\n'
  ask proto '请输入选项' 1 >/dev/null
  case "$proto" in
    1) proto=ss ;;
    2) proto=vless ;;
    3) proto=trojan ;;
    4) proto=vlessenc ;;
    *) proto=ss ;;
  esac

  case "$proto" in
    ss)
      ask cipher '加密方式' "$(st_get LANDING_CIPHER 2022-blake3-aes-256-gcm)"
      ask pass '密码（2022 系列为 base64 密钥）' "$(st_get LANDING_PASS)"
      [ -z "$pass" ] && { warn "密码不能为空"; return 1; }
      st_set LANDING_CIPHER "$cipher"; st_set LANDING_PASS "$pass"
      ;;
    trojan)
      ask pass '密码' "$(st_get LANDING_PASS)"
      ask sni  'SNI / 伪装域名' "$(st_get LANDING_SNI)"
      st_set LANDING_PASS "$pass"; st_set LANDING_SNI "$sni"
      ;;
    vless)
      ask uuid 'UUID' "$(st_get LANDING_UUID)"
      ask sni  'SNI / 伪装域名' "$(st_get LANDING_SNI)"
      ask pbk  'Reality 公钥 (pbk，落地机生成)' "$(st_get LANDING_PBK)"
      ask sid  'Reality short-id' "$(st_get LANDING_SID)"
      st_set LANDING_UUID "$uuid"; st_set LANDING_SNI "$sni"
      st_set LANDING_PBK "$pbk"; st_set LANDING_SID "$sid"
      ;;
    vlessenc)
      ask uuid 'UUID' "$(st_get LANDING_UUID)"
      ask sni  'SNI / 伪装域名' "$(st_get LANDING_SNI)"
      ask pbk  'Reality 公钥 (pbk)' "$(st_get LANDING_PBK)"
      ask sid  'Reality short-id' "$(st_get LANDING_SID)"
      ask enc  'encryption 值（落地机生成的 [Client] 那一行）' "$(st_get LANDING_ENC)"
      st_set LANDING_UUID "$uuid"; st_set LANDING_SNI "$sni"
      st_set LANDING_PBK "$pbk"; st_set LANDING_SID "$sid"; st_set LANDING_ENC "$enc"
      ;;
  esac

  ask ipver '落地机是否只能走 IPv6 连？(auto/ipv6)' "$(st_get LANDING_IPVER auto)"
  st_set LANDING_IPVER "$ipver"
  st_set EGRESS_MODE landing
  st_set LANDING_HOST "$host"; st_set LANDING_PORT "$port"; st_set LANDING_PROTO "$([ "$proto" = vlessenc ] && echo vless || echo "$proto")"
  [ "$proto" = vlessenc ] && st_set LANDING_ENC "$(st_get LANDING_ENC)"
  ok "落地已记录：$host:$port ($proto)"
}

# --------------------------------------------------------------- 节点 菜单 ----
node_note() {
  case "$1" in
    ss)       printf '%s' "$(st_get SS_CIPHER 2022-blake3-aes-256-gcm)" ;;
    reality)  printf 'SNI=%s' "$(st_get REALITY_SNI www.microsoft.com)" ;;
    vlessenc) printf 'PQ+Reality SNI=%s' "$(st_get REALITY_SNI www.microsoft.com)" ;;
  esac
}

menu_nodes() {
  local i spec
  while :; do
    clear 2>/dev/null || true
    hr
    printf '  节点管理（多协议可共存，新增不覆盖已有节点）\n'
    hr
    printf '  %-3s %-11s %-7s %s\n' '#' '协议' '端口' '参数'
    i=0
    while read -r spec; do
      [ -z "$spec" ] && continue
      i=$((i+1))
      printf '  %-3s %-11s %-7s %s\n' "$i" "$(_pt_name "${spec%%:*}")" "${spec##*:}" "$(node_note "${spec%%:*}")"
    done < <(inb_list)
    hr
    printf ' 1. 新增节点        （选协议与端口，已有节点不受影响）\n'
    printf ' 2. 删除节点        （按序号，按端口精准删除）\n'
    printf ' 3. 修改端口        （按序号）\n'
    printf ' 4. 重新生成密钥    （同一协议的节点共用凭据）\n'
    printf ' 5. 修改监听地址    （默认 "::" 双栈）\n'
    printf ' 0. 返回\n'
    hr
    ask c '请输入选项' "" >/dev/null
    case "$c" in
      1) do_node_add ;;
      2) do_node_del ;;
      3) do_node_port ;;
      4) do_regen ;;
      5) do_listen_addr ;;
      0) return ;;
    esac
    st_save
  done
}

default_port() {
  case "$1" in
    ss)       echo 35688 ;;
    reality)  echo 443 ;;
    vlessenc) echo 8443 ;;
    *)        echo 35688 ;;
  esac
}

do_node_add() {
  local proto pt
  printf ' 1) Shadowsocks 2022  2) VLESS Reality  3) VLESS Encryption(PQ)\n'
  ask c '协议' 1 >/dev/null
  case "$c" in
    2) proto=reality ;;
    3) proto=vlessenc ;;
    *) proto=ss ;;
  esac
  case "$proto" in
    ss)       prep_ss ;;
    reality)  prep_reality ;;
    vlessenc) prep_vlessenc ;;
  esac
  ask_port pt "端口（$(_pt_name "$proto")）" "$(default_port "$proto")"
  port_in_use "$pt" && warn "端口 $pt 已在本机被占用，确认一下"
  inb_add "$proto" "$pt" || return 1
  ok "已新增 $(_pt_name "$proto"):$pt —— 记得「应用并重启」"
}

do_node_del() {
  local idx spec
  [ "$(inb_count)" -le 1 ] && { warn "只剩一个节点，先新增再删"; return 1; }
  ask idx '要删除的序号' ""
  [[ "$idx" =~ ^[0-9]+$ ]] || { err "序号无效"; return 1; }
  spec="$(inb_list | sed -n "${idx}p")"
  [ -z "$spec" ] && { err "没有第 $idx 个节点"; return 1; }
  confirm "删除 $(_pt_name "${spec%%:*}") : ${spec##*:} ?" N || return 1
  inb_del "$idx" && ok "已删除"
}

do_node_port() {
  local idx spec np
  ask idx '要改端口的序号' "1"
  [[ "$idx" =~ ^[0-9]+$ ]] || { err "序号无效"; return 1; }
  spec="$(inb_list | sed -n "${idx}p")"
  [ -z "$spec" ] && { err "没有第 $idx 个节点"; return 1; }
  ask_port np '新端口' "${spec##*:}"
  st_set INBOUNDS "$(inb_list | sed "${idx}s/.*/${spec%%:*}:${np}/")"
  sync_primary
  ok "端口已改为 $np"
}

do_listen_addr() {
  local a; ask a '监听地址（:: 双栈 / 0.0.0.0 仅 v4 / 指定 IP）' "$(st_get LISTEN_ADDR ::)"
  [ -z "$a" ] && return 1
  st_set LISTEN_ADDR "$a"; ok "监听地址：$a"
}

prep_ss() {
  local cipher p
  printf ' 1) 2022-blake3-aes-256-gcm（推荐） 2) 2022-blake3-aes-128-gcm 3) aes-256-gcm(旧)\n'
  ask c '请输入选项' 1 >/dev/null
  case "$c" in
    2) cipher=2022-blake3-aes-128-gcm ;;
    3) cipher=aes-256-gcm ;;
    *) cipher=2022-blake3-aes-256-gcm ;;
  esac
  st_set SS_CIPHER "$cipher"
  if [ "$(st_get SS_CIPHER_SAVED)" != "$cipher" ] || [ -z "$(st_get SS_PASS)" ]; then
    if [[ "$cipher" == 2022-* ]]; then
      st_set SS_PASS "$(gen_ss_pass "$cipher")"
    else
      ask p '自定义密码（留空自动生成）' ""
      [ -z "$p" ] && p="$(head -c 18 /dev/urandom | base64 | tr -d '\n=+/')"
      st_set SS_PASS "$p"
    fi
    st_set SS_CIPHER_SAVED "$cipher"
  fi
  ok "Shadowsocks 参数就绪：$cipher"
}

prep_reality() {
  local sni
  ask sni '伪装域名 SNI（建议 www.microsoft.com）' "$(st_get REALITY_SNI www.microsoft.com)"
  st_set REALITY_SNI "$sni"; st_set REALITY_DEST "$(st_get REALITY_DEST "$sni:443")"
  [ -z "$(st_get UUID)" ] && st_set UUID "$(gen_uuid)"
  { [ -z "$(st_get REALITY_PRIV)" ] || [ -z "$(st_get REALITY_PUB)" ]; } && gen_reality
  ok "VLESS Reality 参数就绪：SNI=$sni"
}

prep_vlessenc() {
  prep_reality
  [ -z "$(st_get VENC_SERVER)" ] && gen_vlessenc
  ok "VLESS Encryption (PQ) 参数就绪"
}

do_regen() {
  local spec
  while read -r spec; do
    [ -z "$spec" ] && continue
    case "${spec%%:*}" in
      ss)       st_set SS_PASS "$(gen_ss_pass "$(st_get SS_CIPHER 2022-blake3-aes-256-gcm)")" ;;
      reality)  gen_reality; st_set UUID "$(gen_uuid)" ;;
      vlessenc) gen_reality; gen_vlessenc; st_set UUID "$(gen_uuid)" ;;
    esac
  done < <(inb_list)
  ok "密钥已重新生成（同协议节点同步生效，客户端需重新导入）"
}

menu_routing() {
  hr
  printf ' 分流   当前：%s\n' "$(st_get ROUTE_MODE auto)"
  hr
  printf ' 1. 全部走出口（推荐，最省心）\n'
  printf ' 2. 国内直连 + 其余走出口（省流量/降延迟，依赖 GEOIP 数据）\n'
  printf ' 0. 返回\n'
  hr
  ask c '请输入选项' "" >/dev/null
  case "$c" in
    1) st_set ROUTE_MODE global; ok "全部走出口" ;;
    2) st_set ROUTE_MODE split; ok "国内直连" ;;
    0) return ;;
  esac
  st_save
}

b64url() { base64 -w0 2>/dev/null | tr '+/' '-_' | tr -d '='; }
urlenc() { printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/?/%3F/g' -e 's/#/%23/g' -e 's/&/%26/g' -e 's/=/%3D/g' -e 's/+/%2B/g'; }

# ------------------------------------------------------- 链接 / 客户端配置 ----
# 单节点：分享链接
print_link() { # <proto> <host> <port> <remark>
  local p="$1" h="$2" pt="$3" rm="$4"
  case "$p" in
    ss)
      printf '\n# Shadowsocks 链接（%s）\n' "$pt"
      printf 'ss://%s@%s:%s#%s\n' \
        "$(printf '%s:%s' "$(st_get SS_CIPHER)" "$(st_get SS_PASS)" | b64url)" \
        "$h" "$pt" "$rm"
      ;;
    reality)
      printf '\n# VLESS Reality 链接（%s）\n' "$pt"
      printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&type=tcp&flow=xtls-rprx-vision#%s\n' \
        "$(st_get UUID)" "$h" "$pt" "$(st_get REALITY_SNI)" "$(st_get REALITY_PUB)" "$(st_get REALITY_SID)" "$rm"
      ;;
    vlessenc)
      printf '\n# VLESS Encryption (PQ) 链接（%s）\n' "$pt"
      printf 'vless://%s@%s:%s?encryption=%s&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&type=tcp&flow=xtls-rprx-vision#%s\n' \
        "$(st_get UUID)" "$h" "$pt" "$(urlenc "$(st_get VENC_CLIENT)")" \
        "$(st_get REALITY_SNI)" "$(st_get REALITY_PUB)" "$(st_get REALITY_SID)" "$rm"
      ;;
  esac
}

# 单节点：mihomo 客户端 proxies 片段
print_client_proxy() { # <proto> <host> <port> <remark>
  local p="$1" h="$2" pt="$3" rm="$4"
  case "$p" in
    ss)
      printf '  - name: "%s"\n    type: ss\n    server: %s\n    port: %s\n    cipher: %s\n    password: "%s"\n    udp: true\n' \
        "$rm" "$h" "$pt" "$(st_get SS_CIPHER)" "$(st_get SS_PASS)" ;;
    reality)
      printf '  - name: "%s"\n    type: vless\n    server: %s\n    port: %s\n    uuid: %s\n    flow: xtls-rprx-vision\n    tls: true\n    servername: %s\n    client-fingerprint: chrome\n    reality-opts:\n      public-key: %s\n      short-id: %s\n    udp: true\n' \
        "$rm" "$h" "$pt" "$(st_get UUID)" "$(st_get REALITY_SNI)" "$(st_get REALITY_PUB)" "$(st_get REALITY_SID)" ;;
    vlessenc)
      printf '  - name: "%s"\n    type: vless\n    server: %s\n    port: %s\n    uuid: %s\n    flow: xtls-rprx-vision\n    tls: true\n    servername: %s\n    client-fingerprint: chrome\n    encryption: "%s"\n    reality-opts:\n      public-key: %s\n      short-id: %s\n    udp: true\n' \
        "$rm" "$h" "$pt" "$(st_get UUID)" "$(st_get REALITY_SNI)" "$(st_get VENC_CLIENT)" "$(st_get REALITY_PUB)" "$(st_get REALITY_SID)" ;;
  esac
}

show_links() {
  local host i spec p pt pp rm
  host="$(public_host)"
  [ -z "$host" ] && { warn "还没配置入口，先跑一遍「1. 入口」"; pause; return; }

  hr
  printf '  服务端：%s  →  %s\n' "$(ingress_desc)" "$(egress_desc)"
  printf '  对外主机：%s   节点数：%s\n' "$host" "$(inb_count)"
  hr

  printf '\n# ------------------- 分享链接 -------------------\n'
  i=0
  while read -r spec; do
    [ -z "$spec" ] && continue
    i=$((i+1)); p="${spec%%:*}"; pt="${spec##*:}"
    pp="$(node_pub_port "$i" "$pt")"
    rm="mlr-$(_pt_name "$p")-$pp"
    print_link "$p" "$host" "$pp" "$rm"
  done < <(inb_list)

  printf '\n\n# ------- mihomo / Clash.Meta 客户端片段（粘到 proxies 下）-------\n'
  i=0
  while read -r spec; do
    [ -z "$spec" ] && continue
    i=$((i+1)); p="${spec%%:*}"; pt="${spec##*:}"
    pp="$(node_pub_port "$i" "$pt")"
    rm="mlr-$(_pt_name "$p")-$pp"
    print_client_proxy "$p" "$host" "$pp" "$rm"
  done < <(inb_list)

  hr
  if [ "$(st_get INGRESS v6)" = "nat" ] || [ "$(st_get INGRESS v6)" = "relay" ]; then
    warn "NAT/中转 模式下只有「第 1 个节点」做了端口映射，其余端口需在商家面板/中转机上另行映射"
  fi
  [ "$(st_get EGRESS_MODE local)" = "landing" ] && \
    info "落地机若也用本脚本，把上面片段反向填到落地机的「2. 指定落地机」里即可"
  pause
}


# ---------------------------------------------------------------- 状态/自检 ----
show_status() {
  hr
  printf '  服务：%s\n' "$(svc_active && echo "运行中" || echo "未运行")"
  printf '  二进制：%s %s\n' "$BIN" "$([ -x "$BIN" ] && "$BIN" -v 2>/dev/null | head -1 || echo '(未安装)')"
  printf '  配置：%s %s\n' "$CFG" "$([ -f "$CFG" ] && echo "($(wc -l <"$CFG") 行)" || echo '(不存在)')"
  printf '  入口：%s\n' "$(ingress_desc)"
  printf '  出口：%s\n' "$(egress_desc)"
  printf '  协议：%s  端口：%s\n' "$(proto_desc)" "$(st_get PORT 35688)"
  hr
  printf ' 监听：\n'
  local _l _found=0
  while read -r _l; do
    case "$_l" in *":$(st_get PORT 35688)"*) printf '   %s\n' "$_l"; _found=1 ;; esac
  done < <(listen_socks)
  [ "$_found" = "1" ] || printf '   （未监听 %s）\n' "$(st_get PORT 35688)"
  printf ' 本机 IPv6：%s\n' "$(det_v6 || true)"
  printf ' 本机内网 IPv4：%s\n' "$(det_v4_local || true)"
  printf ' 本机 v4 出网：%s\n' "$(probe_egress4 2>/dev/null || echo "不可用")"
  hr
  printf ' 防火墙放行（按需执行）：\n'
  printf '   iptables -I INPUT -p tcp --dport %s -j ACCEPT\n' "$(st_get PORT 35688)"
  printf '   iptables -I INPUT -p udp --dport %s -j ACCEPT\n' "$(st_get PORT 35688)"
  printf '   ip6tables -I INPUT -p tcp --dport %s -j ACCEPT\n' "$(st_get PORT 35688)"
  hr
  printf ' 最近日志：\n'
  journalctl -u "$SVC" -n 12 --no-pager 2>/dev/null | sed 's/^/   /' || echo "   （无）"
  hr
  pause
}

# ------------------------------------------------------------ 备份/卸载 ----
menu_backup() {
  hr
  printf ' 1. 备份当前配置\n 2. 还原上一次备份\n 3. 查看备份列表\n 4. 卸载 mihomo 与脚本环境\n 0. 返回\n'
  hr
  ask c '请输入选项' "" >/dev/null
  case "$c" in
    1) mkdir -p "$BK"; cp -f "$CFG" "$BK/config.$(date +%s).yaml" && ok "已备份" ;;
    2) restore_last_backup && svc_restart ;;
    3) ls -1t "$BK" 2>/dev/null | head -20 || warn "暂无备份" ;;
    4) do_uninstall ;;
    0) return ;;
  esac
  pause
}

do_uninstall() {
  confirm "确认卸载？将停止服务并删除 ${BIN}（配置与备份保留）" N || return 1
  if [ "$DRY" != "1" ]; then
    systemctl disable --now "$SVC" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/${SVC}.service"
    systemctl daemon-reload 2>/dev/null || true
    rm -f "$BIN"
  fi
  ok "已卸载（配置留在 $ETC，可手动删除）"
}

do_selfupdate() {
  local tmp; tmp="$(mktemp)"
  info "从 $MLR_RAW/mlr 获取最新版本"
  if ! curl -fsSL --max-time 30 -o "$tmp" "$MLR_RAW/mlr"; then
    err "下载失败"; rm -f "$tmp"; return 1
  fi
  bash -n "$tmp" || { err "新版本语法检查失败，放弃"; rm -f "$tmp"; return 1; }
  local nv; nv="$(grep -m1 '^MLR_VERSION=' "$tmp" | cut -d'"' -f2)"
  info "本地 $MLR_VERSION / 远端 ${nv:-未知}"
  install -m 755 "$tmp" "$0" && ok "已更新，重新运行生效"
  rm -f "$tmp"
}

# ----------------------------------------------------------------- 自检矩阵 ----
cmd_selftest() {
  local work="$ETC/selftest" pass=0 fail=0 t
  mkdir -p "$work"
  mihomo_ensure >/dev/null 2>&1 || { err "需要 mihomo 二进制"; return 1; }
  st_set UUID "$(gen_uuid)"; st_set PORT 35688
  gen_reality >/dev/null 2>&1; gen_vlessenc >/dev/null 2>&1
  st_set SS_CIPHER 2022-blake3-aes-256-gcm; st_set SS_PASS "$(gen_ss_pass 2022-blake3-aes-256-gcm)"
  st_set REALITY_SNI www.microsoft.com; st_set REALITY_DEST www.microsoft.com:443

  local protos=(ss reality vlessenc)
  local egresses=(local landing_ss landing_vless)
  local routes=(global split)
  local listens=('::' '0.0.0.0' '10.66.66.2')

  for p in "${protos[@]}"; do
    for e in "${egresses[@]}"; do
      for r in "${routes[@]}"; do
        st_set INBOUNDS "$p:35688"; sync_primary; st_set ROUTE_MODE "$r"; st_set LISTEN_ADDR '::'
        case "$e" in
          local) st_set EGRESS_MODE local ;;
          landing_ss)
            st_set EGRESS_MODE landing; st_set LANDING_PROTO ss
            st_set LANDING_HOST 203.0.113.10; st_set LANDING_PORT 35688
            st_set LANDING_CIPHER 2022-blake3-aes-256-gcm
            st_set LANDING_PASS "$(st_get SS_PASS)" ;;
          landing_vless)
            st_set EGRESS_MODE landing; st_set LANDING_PROTO vless
            st_set LANDING_HOST jp.example.com; st_set LANDING_PORT 443
            st_set LANDING_UUID "$(st_get UUID)"; st_set LANDING_SNI www.microsoft.com
            st_set LANDING_PBK "$(st_get REALITY_PUB)"; st_set LANDING_SID "$(st_get REALITY_SID)" ;;
        esac
        render_config "$work/cfg.yaml"
        if "$BIN" -t -d "$work" -f "$work/cfg.yaml" >"$work/out.log" 2>&1; then
          pass=$((pass+1))
        else
          fail=$((fail+1)); err "FAIL  proto=$p egress=$e route=$r"
          sed -n '1,6p' "$work/out.log" | sed 's/^/        /'
        fi
      done
    done
    # 监听地址变体
    st_set INBOUNDS "$p:35688"; sync_primary; st_set ROUTE_MODE global; st_set EGRESS_MODE local
    for l in "${listens[@]}"; do
      st_set LISTEN_ADDR "$l"
      render_config "$work/cfg.yaml"
      if "$BIN" -t -d "$work" -f "$work/cfg.yaml" >"$work/out.log" 2>&1; then
        pass=$((pass+1))
      else
        fail=$((fail+1)); err "FAIL  proto=$p listen=$l"
        sed -n '1,6p' "$work/out.log" | sed 's/^/        /'
      fi
    done
  done

  st_set LISTEN_ADDR '::'

  # 多节点共存（一台机器上 4 种协议同时监听）
  local multi_combo
  for multi_combo in \
      "ss:35688,reality:443,vlessenc:8443" \
      "ss:35688,ss:35689" \
      "reality:443,vlessenc:8443"; do
    st_set INBOUNDS "$multi_combo"; sync_primary
    for e in local landing_ss; do
      if [ "$e" = "local" ]; then
        st_set EGRESS_MODE local
      else
        st_set EGRESS_MODE landing; st_set LANDING_PROTO ss
        st_set LANDING_HOST 203.0.113.10; st_set LANDING_PORT 35688
        st_set LANDING_CIPHER 2022-blake3-aes-256-gcm
        st_set LANDING_PASS "$(st_get SS_PASS)"
      fi
      render_config "$work/cfg.yaml"
      if "$BIN" -t -d "$work" -f "$work/cfg.yaml" >"$work/out.log" 2>&1; then
        pass=$((pass+1))
      else
        fail=$((fail+1)); err "FAIL  multi=$multi_combo egress=$e"
        sed -n '1,8p' "$work/out.log" | sed 's/^/        /'
      fi
    done
  done
  st_set INBOUNDS "ss:35688"; st_set EGRESS_MODE local; sync_primary

  hr
  printf ' 自检结果：通过 %s / 失败 %s\n' "$pass" "$fail"
  hr
  [ "$fail" -eq 0 ]
}

