usage() {
  cat <<EOF
mlr v${MLR_VERSION} — Mihomo 中转/落地一键管理

用法：mlr [选项]
  (无参数)        交互式菜单
  --info          输出当前入口/出口/链接
  --status        状态与自检信息
  --apply         按当前状态重新生成配置并重启
  --detect        网络环境探测
  --selftest      配置矩阵自检（需要 mihomo 二进制）
  --uninstall     卸载
  --update        更新脚本自身
  -h, --help      帮助

环境变量：
  MLR_ETC   配置目录（默认 /etc/mihomo）
  MLR_BIN   mihomo 路径（默认 /usr/local/bin/mihomo）
  MLR_DRY   1 = 不触碰系统（调试用）
EOF
}

