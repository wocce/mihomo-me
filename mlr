mkdir -p "$ETC" 2>/dev/null || true
chmod 700 "$ETC" 2>/dev/null || true
st_load

case "${1:-}" in
  --info)      need_root; show_links ;;
  --status)    need_root; show_status ;;
  --apply)     need_root; mihomo_ensure && apply_config ;;
  --detect)    do_detect ;;
  --selftest)  cmd_selftest ;;
  --uninstall) need_root; do_uninstall ;;
  --update)    do_selfupdate ;;
  -h|--help)   usage ;;
  "")          need_root; [ -f "$STATE" ] && main_menu || first_run ;;
  *)           usage; exit 1 ;;
esac
