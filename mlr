do_ingress_v6() {
  local v6
  v6="$(det_v6)"
  if [ -z "$v6" ]; then
    warn "没有检测到全局 IPv6 地址，请确认网卡配置"
    ask v6 '手动输入本机 IPv6' '' 
    [ -z "$v6" ] && return 1
  fi
  st_set INGRESS v6
  st_set V6ADDR "$v6"
  ok "入口已设为 IPv6 直连：[$v6]:$(st_get PORT 35688)"
  info "客户端直连地址（需自身有 IPv6）：[$v6]:$(st_get PORT 35688)"
  info "本机防火墙记得放行端口，见「6. 状态/自检」里的放行命令"
}

do_ingress_nat() {
  local pub pp iport
  hr
  printf ' 供应商给的 IPv4 NAT 入口：公网 v4:端口  →  映射到本机 内网v4:端口\n'
  printf ' 大多数商家是 1:1 映射（外部端口=内部端口），只需要填外部地址。\n'
  hr
  ask pub  '公网 IPv4（商家提供的入口地址）' "$(st_get NAT_PUB_IP)"
  [ -z "$pub" ] && { warn "必须填写公网 IPv4"; return 1; }
  ask_port pp '公网端口' "$(st_get NAT_PUB_PORT "$(st_get PORT 35688)")"
  ask_port iport '映射到本机的端口（通常与公网端口相同）' "$(st_get NAT_INT_PORT "$pp")"

  st_set INGRESS nat
  st_set NAT_PUB_IP "$pub"
  st_set NAT_PUB_PORT "$pp"
  st_set NAT_INT_PORT "$iport"

  if [ "$iport" != "$(st_get PORT 35688)" ]; then
    info "内部端口 $iport 与监听端口 $(st_get PORT 35688) 不同，本机添加端口重定向"
    fw_redirect "$iport" "$(st_get PORT 35688)"
  fi
  ok "入口已设为 IPv4 NAT：$pub:$pp → 本机 $iport"
  info "若商家面板支持自定义映射，确保 外部 $pp → 内网 $(det_v4_local 2>/dev/null || echo 10.x.x.x):$iport"
  info "「查看链接」里生成的地址会自动用 $pub:$pp"
}

fw_redirect() { # $1=from_port $2=to_port
  [ "$DRY" = "1" ] && { info "DRY: iptables REDIRECT $1→$2"; return 0; }
  iptables -t nat -C PREROUTING -p tcp --dport "$1" -j REDIRECT --to-ports "$2" 2>/dev/null || \
    iptables -t nat -A PREROUTING -p tcp --dport "$1" -j REDIRECT --to-ports "$2"
  iptables -t nat -C PREROUTING -p udp --dport "$1" -j REDIRECT --to-ports "$2" 2>/dev/null || \
    iptables -t nat -A PREROUTING -p udp --dport "$1" -j REDIRECT --to-ports "$2"
  if command -v netfilter-persistent >/dev/null 2>&1; then
    netfilter-persistent save >/dev/null 2>&1 && ok "重定向规则已持久化"
  else
    warn "未安装 iptables-persistent，重启后规则会失效；可执行：apt install iptables-persistent"
  fi
}

# --------------------------------------------------------- 入口：v4 中转 ----
menu_relay() {
  while :; do
    hr
    printf ' 自有公网 v4 中转机（你有另一台带公网 v4 的机器）\n'
    printf ' 当前：%s\n' "$(ingress_desc)"
    hr
    printf ' 1. Realm 转发   中转机必须有 IPv6（直接按 v6 回源到本机）\n'
    printf ' 2. WireGuard    中转机没有 IPv6 也行（本机主动拨出建隧道）\n'
    printf ' 0. 返回\n'
    hr
    ask c '请输入选项' "" >/dev/null
    case "$c" in
      1) do_relay_realm ;;
      2) do_relay_wg ;;
      0) return ;;
    esac
  done
}

do_relay_realm() {
  local host rport
  ask host '中转机公网 IPv4 或域名' "$(st_get RELAY_HOST)"
  [ -z "$host" ] && return 1
  ask_port rport '中转机对外端口（客户端连这个）' "$(st_get RELAY_PORT "$(st_get PORT 35688)")"
  st_set INGRESS relay; st_set RELAY_MODE realm
  st_set RELAY_HOST "$host"; st_set RELAY_PORT "$rport"

  local v6 port
  v6="$(st_get V6ADDR "$(det_v6)")"; port="$(st_get PORT 35688)"
  [ -z "$v6" ] && die "本机没有 IPv6 地址，Realm 方案不可用"

  cat <<EOF

---- 在中转机（$host）上执行 ----------------------------------
# 1) 装 realm
curl -fL -o /tmp/realm.tar.gz https://github.com/zhboner/realm/releases/latest/download/realm-x86_64-unknown-linux-musl.tar.gz
tar -xzf /tmp/realm.tar.gz -C /usr/local/bin --strip-components=1 && chmod +x /usr/local/bin/realm

# 2) 配置 /etc/realm/config.toml
cat > /etc/realm/config.toml <<'TOML'
[network]
no_tcp = false
use_udp = true

[[endpoints]]
listen = "0.0.0.0:$rport"
remote = "[$v6]:$port"
TOML

# 3) 开机自启
cat > /etc/systemd/system/realm.service <<'UNIT'
[Unit]
Description=realm forwarder
After=network-online.target
[Service]
ExecStart=/usr/local/bin/realm -c /etc/realm/config.toml
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload && systemctl enable --now realm
# 4) 放行端口
iptables -I INPUT -p tcp --dport $rport -j ACCEPT
iptables -I INPUT -p udp --dport $rport -j ACCEPT
---------------------------------------------------------------

EOF
  ok "Realm 方案已记录：$host:$rport → [$v6]:$port"
}

gen_wg_keypair() { # 输出 "私钥 公钥"
  local priv pub
  if command -v wg >/dev/null 2>&1; then
    priv="$(wg genkey)"; pub="$(printf '%s' "$priv" | wg pubkey)"
  elif [ -x "$BIN" ]; then
    local out; out="$("$BIN" generate wg-keypair 2>/dev/null)"
    priv="$(printf '%s\n' "$out" | sed -n 's/^PrivateKey: *//p')"
    pub="$(printf '%s\n' "$out" | sed -n 's/^PublicKey: *//p')"
  else
    die "需要 wireguard-tools 或 mihomo 来生成密钥"
  fi
  printf '%s %s' "$priv" "$pub"
}

do_relay_wg() {
  local host wport pub_port
  ask host '中转机公网 IPv4 或域名' "$(st_get RELAY_HOST)"
  [ -z "$host" ] && return 1
  ask_port wport 'WireGuard 监听端口（中转机上）' "$(st_get RELAY_WG_PORT 51820)"
  ask_port pub_port '客户端连接中转机的对外端口' "$(st_get RELAY_PUB_PORT "$(st_get PORT 35688)")"

  local srvp srvpub clip clipub kp
  kp="$(gen_wg_keypair)"; srvp="${kp%% *}"; srvpub="${kp#* }"
  kp="$(gen_wg_keypair)"; clip="${kp%% *}"; clipub="${kp#* }"

  st_set INGRESS relay; st_set RELAY_MODE wg
  st_set RELAY_HOST "$host"; st_set RELAY_WG_PORT "$wport"; st_set RELAY_PUB_PORT "$pub_port"
  st_set WG_SRV_PRIV "$srvp"; st_set WG_SRV_PUB "$srvpub"
  st_set WG_CLI_PRIV "$clip"; st_set WG_CLI_PUB "$clipub"

  local port; port="$(st_get PORT 35688)"

  cat <<EOF

---- ① 中转机（$host） ----------------------------------------
apt install -y wireguard-tools iptables
cat > /etc/wireguard/wg0.conf <<'WGC'
[Interface]
Address = 10.66.66.1/24
ListenPort = $wport
PrivateKey = $srvp
PostUp   = iptables -I INPUT -p udp --dport $wport -j ACCEPT
PostUp   = iptables -I FORWARD -i wg0 -j ACCEPT
PostUp   = iptables -I FORWARD -o wg0 -j ACCEPT
PostUp   = iptables -t nat -A PREROUTING -p tcp --dport $pub_port -j DNAT --to-destination 10.66.66.2:$port
PostUp   = iptables -t nat -A PREROUTING -p udp --dport $pub_port -j DNAT --to-destination 10.66.66.2:$port
PostUp   = iptables -t nat -A POSTROUTING -s 10.66.66.0/24 -j MASQUERADE
PostDown = iptables -t nat -D PREROUTING -p tcp --dport $pub_port -j DNAT --to-destination 10.66.66.2:$port
PostDown = iptables -t nat -D PREROUTING -p udp --dport $pub_port -j DNAT --to-destination 10.66.66.2:$port

[Peer]
PublicKey = $clipub
AllowedIPs = 10.66.66.2/32
WGC
sysctl -w net.ipv4.ip_forward=1
echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-wg.conf
systemctl enable --now wg-quick@wg0

---- ② 本机（入口机，也就是这台）-------------------------------
apt install -y wireguard-tools
cat > /etc/wireguard/wg0.conf <<'WGC'
[Interface]
Address = 10.66.66.2/24
PrivateKey = $clip
Table = off
PostUp = ip -6 route replace default dev wg0 2>/dev/null || true

[Peer]
PublicKey = $srvpub
Endpoint = $host:$wport
AllowedIPs = 10.66.66.1/32
PersistentKeepalive = 25
WGC
systemctl enable --now wg-quick@wg0
# mihomo 的监听地址已经是 "::" ，会同时监听 10.66.66.2，无需改动
---------------------------------------------------------------

EOF
  warn "注意：本机需要有可用的 v4 出网（NAT 也行）才能连上中转机；若完全无 v4，请改用 Realm（中转机需有 v6）"
  ok "WG 方案已记录：客户端连 $host:$pub_port"
}

