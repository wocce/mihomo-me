#!/usr/bin/env bash
# ==============================================================================
#  mlr - Mihomo 中转 / 落地 一键管理工具
#  场景：仅 IPv6 公网的国内线路机（如利群 cnc / 各种 v6-only VPS）作为入口，
#        出口可选「本机直出」或「指定落地机」，入口可选 v6直连 / IPv4 NAT / 自有v4中转。
#  License: MIT
# ==============================================================================
set -uo pipefail
export LC_ALL=C.UTF-8

MLR_VERSION="0.1.0"
MLR_REPO="${MLR_REPO:-wocce/mihomo-me}"
MLR_RAW="${MLR_RAW:-https://raw.githubusercontent.com/${MLR_REPO}/main}"

ETC="${MLR_ETC:-/etc/mihomo}"
CFG="$ETC/config.yaml"
STATE="$ETC/mlr.state"
BK="$ETC/backup"
BIN="${MLR_BIN:-/usr/local/bin/mihomo}"
SVC="mihomo"
DRY="${MLR_DRY:-0}"

C_RESET=$'\033[0m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
C_R=$'\033[31m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_C=$'\033[36m'

declare -A ST=()
c=""          # 菜单选择共用变量

# ---------------------------------------------------------------- 基础输出 ----
hr() { printf '%s\n' "============================================================"; }
ok()   { printf '%s[ OK ]%s %s\n' "$C_G" "$C_RESET" "$*"; }
info() { printf '%s[ .. ]%s %s\n' "$C_C" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_Y" "$C_RESET" "$*"; }
err()  { printf '%s[FAIL]%s %s\n' "$C_R" "$C_RESET" "$*" >&2; }
die()  { err "$*"; exit 1; }
pause(){ printf '\n按回车继续...'; read -r _ || true; }

need_root() {
  [ "$DRY" = "1" ] && return 0
  [ "$(id -u)" = "0" ] || die "请用 root 运行：sudo $0"
}

# ---------------------------------------------------------------- 状态存储 ----
st_get() { printf '%s' "${ST[$1]:-${2:-}}"; }
st_set() { ST["$1"]="$2"; }

# ---- 多节点（入站）列表：INBOUNDS="ss:35688,reality:443" ----
inb_list() {
  local s; s="$(st_get INBOUNDS)"
  [ -z "$s" ] && s="$(st_get PROTO ss):$(st_get PORT 35688)"
  printf '%s\n' "$s" | tr ',' '\n' | sed '/^[[:space:]]*$/d'
}
inb_count()  { inb_list | wc -l | tr -d ' '; }
inb_primary(){ inb_list | head -1; }
# 把「主节点」同步到 PROTO/PORT，供 NAT/中转/状态显示复用
sync_primary() {
  local p; p="$(inb_primary)"
  [ -z "$p" ] && return 0
  st_set PROTO "${p%%:*}"; st_set PORT "${p##*:}"
}
inb_ports() { inb_list | sed 's/.*://' | tr '\n' ' '; }
inb_add() { # $1=proto $2=port
  local spec="$1:$2" cur out=""
  while read -r cur; do
    [ -z "$cur" ] && continue
    [ "${cur##*:}" = "$2" ] && { err "端口 $2 已被 ${cur%%:*} 占用"; return 1; }
    out="${out}${out:+,}$cur"
  done < <(inb_list)
  out="${out}${out:+,}$spec"
  st_set INBOUNDS "$out"; sync_primary; return 0
}
inb_del() { # $1=索引(1起)
  local i=0 cur out=""
  while read -r cur; do
    i=$((i+1)); [ -z "$cur" ] && continue
    [ "$i" = "$1" ] && continue
    out="${out}${out:+,}$cur"
  done < <(inb_list)
  [ -z "$out" ] && { err "至少保留一个节点（可先新增再删除）"; return 1; }
  st_set INBOUNDS "$out"; sync_primary; return 0
}

st_load() {
  [ -f "$STATE" ] || return 0
  # 只接受 KEY=VALUE 形式，避免任意代码执行
  while IFS='=' read -r k v; do
    k="${k// /}"
    [[ "$k" =~ ^[A-Z][A-Z0-9_]*$ ]] || continue
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    ST["$k"]="$v"
  done < "$STATE"
}

st_save() {
  [ "$DRY" = "1" ] && return 0
  mkdir -p "$ETC"
  local tmp="$STATE.tmp" k esc
  : > "$tmp"
  for k in "${!ST[@]}"; do
    esc="${ST[$k]//\\/\\\\}"; esc="${esc//\"/\\\"}"
    printf '%s="%s"\n' "$k" "$esc" >> "$tmp"
  done
  mv -f "$tmp" "$STATE"
  chmod 600 "$STATE"
}

# ---------------------------------------------------------------- 环境探测 ----
det_arch() {
  case "$(uname -m)" in
    x86_64|amd64)  echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    armv7l)        echo armv7 ;;
    *)             echo unknown ;;
  esac
}

det_v6() {
  ip -6 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1
}

det_v4_local() {
  ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1
}

# 本机能否主动出网（v4 / v6）
probe_egress4() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -4 -fsS --max-time 6 https://api-ipv4.ip.sb/ip 2>/dev/null | tr -d '[:space:]'
}

probe_egress6() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -6 -fsS --max-time 6 https://api-ipv6.ip.sb/ip 2>/dev/null | tr -d '[:space:]'
}

os_id() { [ -r /etc/os-release ] && . /etc/os-release && printf '%s' "${ID:-unknown}" || echo unknown; }

pkg_install() {
  [ "$DRY" = "1" ] && { info "DRY: 跳过安装 $*"; return 0; }
  case "$(os_id)" in
    debian|ubuntu)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq >/dev/null 2>&1 || true
      apt-get install -y -qq "$@" >/dev/null 2>&1 ;;
    alpine) apk add --no-cache "$@" >/dev/null 2>&1 ;;
    centos|rhel|rocky|almalinux|fedora) dnf install -y -q "$@" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------- 输入助手 ----
ask() { # ask <变量名> <提示> <默认值>
  local var="$1" prompt="$2" def="${3:-}" ans=""
  if [ -n "$def" ]; then
    printf '%s %s %s[%s]%s: ' "$C_C" "$prompt" "$C_DIM" "$def" "$C_RESET" >&2
  else
    printf '%s %s%s: ' "$C_C" "$prompt" "$C_RESET" >&2
  fi
  read -r ans || ans=""
  [ -z "$ans" ] && ans="$def"
  printf -v "$var" '%s' "$ans"
}

ask_port() { # ask_port <变量名> <提示> <默认值>
  local var="$1" prompt="$2" def="${3:-}" ans
  while :; do
    ask ans "$prompt" "$def"
    if [[ "$ans" =~ ^[0-9]+$ ]] && [ "$ans" -ge 1 ] && [ "$ans" -le 65535 ]; then
      printf -v "$var" '%s' "$ans"; return 0
    fi
    err "端口必须是 1-65535 的整数"
  done
}

confirm() { # confirm <提示> [默认Y]
  local p="$1" d="${2:-Y}" a=""
  printf '%s %s %s[%s]%s: ' "$C_Y" "$p" "$C_DIM" "$d" "$C_RESET" >&2
  read -r a || a=""
  a="${a:-$d}"
  case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

yaml_q() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

# ------------------------------------------------------------ mihomo 二进制 ----
mihomo_latest_tag() {
  curl -fsSLI --max-time 12 "https://github.com/MetaCubeX/mihomo/releases/latest" 2>/dev/null \
    | tr -d '\r' | sed -n 's#^[Ll]ocation:.*/tag/\(.*\)$#\1#p' | tail -1
}

mihomo_asset() { # mihomo_asset <tag> <arch>
  local tag="$1" arch="$2" suffix=""
  [ "$arch" = "amd64" ] && suffix="-compatible"
  printf 'mihomo-linux-%s%s-%s.gz' "$arch" "$suffix" "$tag"
}

# shellcheck disable=SC2120  # 可选传入 tag
mihomo_install_bin() {
  local arch tag asset url tmp
  arch="$(det_arch)"
  [ "$arch" = "unknown" ] && die "不支持的 CPU 架构：$(uname -m)"
  tag="${1:-$(mihomo_latest_tag)}"
  [ -n "$tag" ] || die "无法获取 mihomo 最新版本（检查网络）"
  asset="$(mihomo_asset "$tag" "$arch")"
  url="https://github.com/MetaCubeX/mihomo/releases/download/${tag}/${asset}"
  tmp="$(mktemp -d)"
  info "下载 mihomo ${tag} (${arch})"
  if ! curl -fL --retry 3 --max-time 180 -o "$tmp/m.gz" "$url" 2>/dev/null; then
    for m in "https://ghfast.top/${url}" "https://gh-proxy.com/${url}" "https://ghproxy.net/${url}"; do
      warn "直连失败，尝试镜像：${m%%/https*}"
      if curl -fL --retry 2 --max-time 180 -o "$tmp/m.gz" "$m" 2>/dev/null; then break; fi
    done
  fi
  [ -s "$tmp/m.gz" ] || { rm -rf "$tmp"; die "mihomo 下载失败，请检查网络或代理"; }
  gunzip -f "$tmp/m.gz" || { rm -rf "$tmp"; die "解压失败"; }
  chmod +x "$tmp/m"
  if [ "$DRY" = "1" ]; then
    info "DRY: 将安装到 $BIN"; BIN="$tmp/m"; return 0
  fi
  install -m 755 "$tmp/m" "$BIN"
  rm -rf "$tmp"
  ok "$("$BIN" -v | head -1)"
}

mihomo_ensure() {
  if [ -x "$BIN" ]; then return 0; fi
  local cand
  for cand in /usr/local/bin/mihomo /usr/bin/mihomo /opt/mihomo/mihomo; do
    [ -x "$cand" ] && { BIN="$cand"; return 0; }
  done
  warn "未检测到 mihomo，开始安装"
  mihomo_install_bin || return 1
}

svc_write_unit() {
  [ "$DRY" = "1" ] && return 0
  cat > "/etc/systemd/system/${SVC}.service" <<EOF
[Unit]
Description=mihomo proxy service (managed by mlr)
Documentation=https://github.com/MetaCubeX/mihomo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${BIN} -d ${ETC}
Restart=always
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SVC" >/dev/null 2>&1 || true
}

svc_active() { [ "$DRY" = "1" ] && return 0; systemctl is-active --quiet "$SVC"; }

svc_restart() {
  [ "$DRY" = "1" ] && { info "DRY: 跳过 systemctl restart"; return 0; }
  systemctl restart "$SVC"
  sleep 2
  if ! svc_active; then
    err "服务启动失败，最近日志："
    journalctl -u "$SVC" -n 25 --no-pager 2>/dev/null | tail -25
    return 1
  fi
}

# ------------------------------------------------------------ 密钥/参数生成 ----
gen_uuid() {
  if [ -x "$BIN" ]; then "$BIN" generate uuid 2>/dev/null; else
    cat /proc/sys/kernel/random/uuid 2>/dev/null || printf '%s' "$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
  fi
}

gen_ss_pass() { # $1 = 2022-blake3-aes-128-gcm|2022-blake3-aes-256-gcm
  local bits=256
  case "$1" in *aes-128-gcm) bits=128 ;; *chacha20*) bits=256 ;; esac
  if [ -x "$BIN" ]; then "$BIN" generate ss-password "$bits" 2>/dev/null; else
    head -c "$((bits/8))" /dev/urandom | base64 | tr -d '\n'
  fi
}

gen_reality() { # 输出 REALITY_PRIV / REALITY_PUB
  local out
  if [ -x "$BIN" ]; then
    out="$("$BIN" generate reality-keypair 2>/dev/null)"
    st_set REALITY_PRIV "$(printf '%s\n' "$out" | sed -n 's/^PrivateKey: *//p')"
    st_set REALITY_PUB  "$(printf '%s\n' "$out" | sed -n 's/^PublicKey: *//p')"
  else
    die "需要 mihomo 二进制来生成 Reality 密钥对"
  fi
  st_set REALITY_SID "$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
}

gen_vlessenc() { # 输出 VENC_SERVER(decryption) / VENC_CLIENT(encryption)
  local out priv pass
  [ -x "$BIN" ] || die "需要 mihomo 二进制来生成 VLESS Encryption 参数"
  out="$("$BIN" generate vless-x25519 2>/dev/null)"
  priv="$(printf '%s\n' "$out" | sed -n 's/^PrivateKey: *//p' | head -1)"
  pass="$(printf '%s\n' "$out" | sed -n 's/^Password: *//p' | head -1)"
  [ -n "$priv" ] && [ -n "$pass" ] || die "生成 VLESS Encryption 参数失败"
  st_set VENC_SERVER "mlkem768x25519plus.native.600s.${priv}"
  st_set VENC_CLIENT "mlkem768x25519plus.native.0rtt.${pass}"
}

# --------------------------------------------------------------- 端口占用 ----
port_in_use() { # $1=port
  [ "$DRY" = "1" ] && return 1
  local p="$1" hex
  if command -v ss >/dev/null 2>&1; then
    ss -Hltnu 2>/dev/null | awk '{print $5}' | grep -qE "[:.]${p}$"
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltnu 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}$"
  else
    hex="$(printf '%04X' "$p")"
    awk -v h="$hex" '{split($2,a,":"); if (a[2]==h && $4=="0A") f=1} END{exit !f}' \
      /proc/net/tcp /proc/net/tcp6 2>/dev/null
  fi
}

# 列出本机监听 socket（无 ss/netstat 时回退 /proc）
listen_socks() {
  if command -v ss >/dev/null 2>&1; then
    ss -Hltnu 2>/dev/null | awk '{print $1" "$5}'
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltnu 2>/dev/null | awk 'NR>2{print $1" "$4}'
  else
    awk 'NR>1{printf "%s %s\n", "tcp", $2}' /proc/net/tcp /proc/net/tcp6 2>/dev/null
  fi
}

# ------------------------------------------------------------ 入站渲染 ----
# emit_listener <proto> <port> <name> <listen>
emit_listener() {
  local p="$1" pt="$2" nm="$3" la="$4"
  case "$p" in
    ss)
      printf '  - name: %s\n' "$nm"
      printf '    type: shadowsocks\n'
      printf '    port: %s\n' "$pt"
      printf '    listen: %s\n' "$(yaml_q "$la")"
      printf '    cipher: %s\n' "$(st_get SS_CIPHER 2022-blake3-aes-256-gcm)"
      printf '    password: %s\n' "$(yaml_q "$(st_get SS_PASS)")"
      printf '    udp: true\n'
      ;;
    *)
      printf '  - name: %s\n' "$nm"
      printf '    type: vless\n'
      printf '    port: %s\n' "$pt"
      printf '    listen: %s\n' "$(yaml_q "$la")"
      printf '    users:\n'
      printf '      - username: u1\n'
      printf '        uuid: %s\n' "$(st_get UUID)"
      if [ "$p" = "reality" ] || [ "$p" = "vlessenc" ]; then
        printf '        flow: xtls-rprx-vision\n'
      fi
      if [ "$p" = "vlessenc" ] && [ -n "$(st_get VENC_SERVER)" ]; then
        printf '    decryption: %s\n' "$(yaml_q "$(st_get VENC_SERVER)")"
      fi
      if { [ "$p" = "reality" ] || [ "$p" = "vlessenc" ]; } && [ -n "$(st_get REALITY_PRIV)" ]; then
        printf '    reality-config:\n'
        printf '      dest: %s\n' "$(yaml_q "$(st_get REALITY_DEST www.microsoft.com:443)")"
        printf '      private-key: %s\n' "$(st_get REALITY_PRIV)"
        printf '      short-id:\n'
        printf '        - %s\n' "$(st_get REALITY_SID)"
        printf '      server-names:\n'
        printf '        - %s\n' "$(st_get REALITY_SNI www.microsoft.com)"
      fi
      ;;
  esac
}

# ---------------------------------------------------------- 配置渲染(纯函数) ----
# render_config <输出文件>   只依赖 ST 与全局变量，方便 selftest 复用
render_config() {
  local out="$1"
  local proto egress route port listen_addr unrouted
  proto="$(st_get PROTO ss)"
  egress="$(st_get EGRESS_MODE local)"
  route="$(st_get ROUTE_MODE auto)"
  port="$(st_get PORT 35688)"
  listen_addr="$(st_get LISTEN_ADDR ::)"
  unrouted="$(st_get UNROUTED 1)"

  {
    printf '# generated by mlr v%s at %s — 手工修改会被下次生成覆盖\n' "$MLR_VERSION" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'mixed-port: 0\n'
    printf 'allow-lan: false\n'
    printf 'mode: rule\n'
    printf 'log-level: %s\n' "$(st_get LOG_LEVEL info)"
    printf 'ipv6: true\n'
    printf 'unified-delay: true\n'
    printf 'tcp-concurrent: true\n'
    printf 'find-process-mode: "off"\n'
    printf 'external-controller: 127.0.0.1:9090\n'
    printf 'profile:\n  store-selected: false\n  store-fake-ip: false\n'
    printf 'dns:\n'
    printf '  enable: true\n'
    printf '  ipv6: true\n'
    printf '  listen: 127.0.0.1:15353\n'
    printf '  enhanced-mode: normal\n'
    printf '  nameserver:\n'
    printf '    - 223.5.5.5\n'
    printf '    - 119.29.29.29\n'
    printf '  fallback:\n'
    printf '    - https://1.1.1.1/dns-query\n'
    printf '    - tls://8.8.8.8\n'
    printf '  fallback-filter:\n'
    printf '    geoip: true\n'
    printf '    geoip-code: CN\n'

    # --- 出站 ---
    printf '\nproxies:\n'
    if [ "$egress" = "landing" ]; then
      render_landing_proxy
    else
      printf '  []\n'
    fi

    printf '\nproxy-groups:\n'
    if [ "$egress" = "landing" ]; then
      printf '  - name: Landing\n    type: select\n    proxies:\n      - LandingNode\n      - DIRECT\n'
    else
      printf '  []\n'
    fi

    # --- 入站（多节点共存，逐个 listeners 追加，互不覆盖）---
    printf '\nlisteners:\n'
    _i=0
    while read -r _spec; do
      [ -z "$_spec" ] && continue
      _i=$((_i+1))
      emit_listener "${_spec%%:*}" "${_spec##*:}" "in-${_i}-${_spec%%:*}" "$listen_addr"
    done < <(inb_list)

    # --- 分流 ---
    printf '\nrules:\n'
    case "$route" in
      split)
        printf '  - GEOIP,CN,DIRECT\n'
        printf '  - MATCH,%s\n' "$([ "$egress" = "landing" ] && echo Landing || echo DIRECT)"
        ;;
      global)
        printf '  - MATCH,%s\n' "$([ "$egress" = "landing" ] && echo Landing || echo DIRECT)"
        ;;
      *)
        # auto：有落地就全部走落地，没落地就本机直出
        printf '  - MATCH,%s\n' "$([ "$egress" = "landing" ] && echo Landing || echo DIRECT)"
        ;;
    esac
    [ "$unrouted" = "1" ] && true
  } > "$out"
  chmod 600 "$out" 2>/dev/null || true
}

render_landing_proxy() {
  local t
  t="$(st_get LANDING_PROTO ss)"
  case "$t" in
    ss)
      printf '  - name: LandingNode\n'
      printf '    type: ss\n'
      printf '    server: %s\n' "$(yaml_q "$(st_get LANDING_HOST)")"
      printf '    port: %s\n' "$(st_get LANDING_PORT 35688)"
      printf '    cipher: %s\n' "$(st_get LANDING_CIPHER 2022-blake3-aes-256-gcm)"
      printf '    password: %s\n' "$(yaml_q "$(st_get LANDING_PASS)")"
      printf '    udp: true\n'
      ;;
    trojan)
      printf '  - name: LandingNode\n'
      printf '    type: trojan\n'
      printf '    server: %s\n' "$(yaml_q "$(st_get LANDING_HOST)")"
      printf '    port: %s\n' "$(st_get LANDING_PORT 443)"
      printf '    password: %s\n' "$(yaml_q "$(st_get LANDING_PASS)")"
      printf '    sni: %s\n' "$(st_get LANDING_SNI)"
      printf '    skip-cert-verify: true\n'
      printf '    udp: true\n'
      ;;
    vless)
      printf '  - name: LandingNode\n'
      printf '    type: vless\n'
      printf '    server: %s\n' "$(yaml_q "$(st_get LANDING_HOST)")"
      printf '    port: %s\n' "$(st_get LANDING_PORT 443)"
      printf '    uuid: %s\n' "$(st_get LANDING_UUID)"
      printf '    flow: xtls-rprx-vision\n'
      printf '    tls: true\n'
      printf '    servername: %s\n' "$(st_get LANDING_SNI)"
      printf '    client-fingerprint: chrome\n'
      printf '    udp: true\n'
      if [ -n "$(st_get LANDING_PBK)" ]; then
        printf '    reality-opts:\n'
        printf '      public-key: %s\n' "$(st_get LANDING_PBK)"
        printf '      short-id: %s\n' "$(st_get LANDING_SID)"
      fi
      if [ -n "$(st_get LANDING_ENC)" ]; then
        printf '    encryption: %s\n' "$(yaml_q "$(st_get LANDING_ENC)")"
      fi
      ;;
  esac
  if [ "$(st_get LANDING_IPVER auto)" = "ipv6" ]; then
    printf '    ip-version: ipv6\n'
  fi
}

# ------------------------------------------------------------- 应用/回滚 ----
apply_config() {
  local tmp="$CFG.new"
  render_config "$tmp" || { err "生成配置失败"; return 1; }

  if [ -x "$BIN" ]; then
    if ! "$BIN" -t -d "$ETC" -f "$tmp" >"$ETC/.mlr-test.log" 2>&1; then
      err "配置校验未通过："
      sed -n '1,20p' "$ETC/.mlr-test.log" >&2
      return 1
    fi
    ok "mihomo -t 配置校验通过"
  fi

  mkdir -p "$BK"
  [ -f "$CFG" ] && cp -f "$CFG" "$BK/config.$(date +%s).yaml"
  mv -f "$tmp" "$CFG"
  chmod 600 "$CFG"

  svc_write_unit
  if ! svc_restart; then
    err "启动失败，尝试回滚到上一次配置"
    restore_last_backup && svc_restart || true
    return 1
  fi
  st_save
  ok "已生效"
}

restore_last_backup() {
  local f
  f="$(ls -1t "$BK"/config.*.yaml 2>/dev/null | head -1)"
  [ -n "$f" ] || { warn "没有可用备份"; return 1; }
  cp -f "$f" "$CFG"
  ok "已还原：$(basename "$f")"
}

# ---------------------------------------------------------------- GEO 数据 ----
geo_update() {
  local d="$ETC" url base="https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest"
  mkdir -p "$d"
  for f in geoip.metadb geosite.dat; do
    info "更新 $f"
    if ! curl -fL --retry 2 --max-time 120 -o "$d/$f.tmp" "$base/$f" 2>/dev/null; then
      curl -fL --retry 2 --max-time 120 -o "$d/$f.tmp" "https://ghfast.top/$base/$f" 2>/dev/null \
        || { warn "$f 下载失败，跳过"; rm -f "$d/$f.tmp"; continue; }
    fi
    [ -s "$d/$f.tmp" ] && mv -f "$d/$f.tmp" "$d/$f"
  done
  ok "GEO 数据已更新"
}

# ------------------------------------------------------------- 入口：描述 ----
ingress_desc() {
  case "$(st_get INGRESS v6)" in
    v6)    printf 'IPv6 直连 :%s' "$(st_get PORT 35688)" ;;
    nat)   printf 'IPv4 NAT %s:%s → 内网 %s' "$(st_get NAT_PUB_IP -)" "$(st_get NAT_PUB_PORT -)" "$(st_get NAT_INT_PORT -)" ;;
    relay) printf '自有v4中转 %s (%s)' "$(st_get RELAY_HOST -)" "$(st_get RELAY_MODE realm)" ;;
    *)     printf '未设置' ;;
  esac
}

proto_desc() {
  local n; n="$(inb_count)"
  local names="" spec
  while read -r spec; do
    [ -z "$spec" ] && continue
    names="${names}${names:+ + }$(_pt_name "${spec%%:*}")"
  done < <(inb_list)
  printf '%s 个节点 [%s]' "$n" "$names"
}

_pt_name() {
  case "$1" in
    ss)       printf 'SS2022' ;;
    reality)  printf 'Reality' ;;
    vlessenc) printf 'VLESS-Enc' ;;
    *)        printf '%s' "$1" ;;
  esac
}

route_desc() {
  case "$(st_get ROUTE_MODE auto)" in
    split)  printf '国内直连' ;;
    global) printf '全部走出口' ;;
    *)      printf '全部走出口' ;;
  esac
}

egress_desc() {
  if [ "$(st_get EGRESS_MODE local)" = "landing" ]; then
    printf '落地 %s:%s (%s)' "$(st_get LANDING_HOST -)" "$(st_get LANDING_PORT -)" "$(st_get LANDING_PROTO ss)"
  else
    printf '本机直出'
  fi
}

# 对外主机（链接里的 host 部分）
public_host() {
  case "$(st_get INGRESS v6)" in
    v6)    st_get V6ADDR ;;
    nat)   st_get NAT_PUB_IP ;;
    relay) st_get RELAY_HOST ;;
    *)     st_get V6ADDR ;;
  esac
}

# 对外端口：NAT/中转 只映射主节点，其余节点用自身端口
node_pub_port() { # $1=序号(1起) $2=本机端口
  if [ "$1" = "1" ]; then
    case "$(st_get INGRESS v6)" in
      nat)   st_get NAT_PUB_PORT "$2"; return ;;
      relay)
        if [ "$(st_get RELAY_MODE realm)" = "realm" ]; then
          st_get RELAY_PORT "$2"
        else
          st_get RELAY_PUB_PORT "$2"
        fi
        return ;;
    esac
  fi
  printf '%s' "$2"
}

