menu_egress() {
  while :; do
    clear 2>/dev/null || true
    hr
    printf '  出口配置   当前：%s\n' "$(egress_desc)"
    hr
    printf ' 1. 本机直出            （本机就是出口，最简单，适合只要「换个入口」）\n'
